.env
.env.*
!.env.example
.git/
vendor/
node_modules/

# OS / editor artifacts
.DS_Store
Thumbs.db

# Logs
*.log

# Runtime files written by CodeIgniter
writable/cache/*
!writable/cache/index.html
writable/debugbar/*
!writable/debugbar/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html

# Uploaded images
public/uploads/avatars/*
!public/uploads/avatars/index.html
public/uploads/products/*
!public/uploads/products/index.html
